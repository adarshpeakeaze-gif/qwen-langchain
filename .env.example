# ==============================================================================
# Document Assistant Configuration
# ==============================================================================
# Copy this file to .env and fill in your values

# ==============================================================================
# API Keys - Multiple keys for rotation (comma-separated for high throughput)
# All models use OpenRouter
# ==============================================================================
# For 250-300 docs/min, you need ~5-6 keys with 60 RPM each
OPENROUTER_API_KEYS=sk-or-key1,sk-or-key2,sk-or-key3,sk-or-key4,sk-or-key5

# Legacy single-key support (used if OPENROUTER_API_KEYS not set)
OPENROUTER_API_KEY=sk-or-v1-xxx

# ==============================================================================
# Model Configuration (all via OpenRouter)
# ==============================================================================
# Vision model options:
# - qwen/qwen2.5-vl-72b-instruct (default, excellent for documents)
# - google/gemini-2.0-flash-001 (fast)
# - openai/gpt-4o (best accuracy, higher cost)
# - anthropic/claude-3.5-sonnet (excellent for documents)
#
# Classifier model options (text-only, fast):
# - openai/gpt-4o-mini (default, fast and cheap)
# - google/gemini-flash-1.5 (alternative)
# - anthropic/claude-3-haiku (alternative)
VISION_MODEL=qwen/qwen2.5-vl-72b-instruct
CLASSIFIER_MODEL=openai/gpt-4o-mini
EXTRACTION_MODEL=qwen/qwen2.5-vl-72b-instruct

# ==============================================================================
# Token Limits
# ==============================================================================
VISION_MAX_TOKENS=4096
CLASSIFIER_MAX_TOKENS=2048
EXTRACTION_MAX_TOKENS=8192

# ==============================================================================
# Thinking Budget (for models that support extended thinking, 0 = disabled)
# ==============================================================================
VISION_THINKING_BUDGET=0
CLASSIFIER_THINKING_BUDGET=0
EXTRACTION_THINKING_BUDGET=0

# ==============================================================================
# Temperature Settings (0.0 = deterministic, 1.0 = creative)
# ==============================================================================
VISION_TEMPERATURE=0.1
CLASSIFIER_TEMPERATURE=0.0
EXTRACTION_TEMPERATURE=0.1

# ==============================================================================
# Retry Configuration
# ==============================================================================
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=30.0
RETRY_EXPONENTIAL_BASE=2.0

# ==============================================================================
# Concurrency & Rate Limiting
# ==============================================================================
# For 300 docs/min: 50 concurrent * 6 keys = 300 theoretical max
MAX_CONCURRENT_REQUESTS=50
REQUESTS_PER_MINUTE_PER_KEY=60
BATCH_SIZE=10

# ==============================================================================
# Timeouts (seconds)
# ==============================================================================
VISION_TIMEOUT=60
CLASSIFIER_TIMEOUT=30
EXTRACTION_TIMEOUT=90

# ==============================================================================
# Server Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=5051
DEBUG=false
MAX_CONTENT_LENGTH=16777216

# ==============================================================================
# PDF Processing
# ==============================================================================
PDF_DPI_SCALE=2.0
PDF_MAX_PAGES=10

# ==============================================================================
# Image Optimization for Vision API
# ==============================================================================
# Optimizing images before sending to vision API reduces processing time
# while preserving document readability.
#
# Max dimension (2048 preserves more detail for text-heavy documents)
IMAGE_MAX_DIMENSION=2048
# JPEG quality (1-100, 92 = high quality, good for documents with small text)
IMAGE_QUALITY=92
# Set to false to disable optimization (sends original image)
IMAGE_OPTIMIZATION_ENABLED=true

# ==============================================================================
# API Base URL (override for proxies or custom endpoints)
# ==============================================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# ==============================================================================
# Logging
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
