# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# LLM Model Configuration
# Vision model for image-to-HTML conversion
VISION_MODEL=google/gemini-2.0-flash-001

# Text model for entity extraction
EXTRACTION_MODEL=google/gemini-2.0-flash-001

# Alternative models you can use:
# - openai/gpt-4o (best accuracy, higher cost)
# - openai/gpt-4o-mini (good balance)
# - anthropic/claude-3.5-sonnet (excellent for documents)
# - anthropic/claude-3-haiku (fast and cheap)
# - google/gemini-2.0-flash-001 (fast, good for OCR)
# - google/gemini-pro-vision (good accuracy)

# Flask Configuration
FLASK_DEBUG=true
FLASK_PORT=5050
